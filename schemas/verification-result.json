{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-office.local/schemas/verification-result.json",
  "title": "Hasil Verifier EdukasiAI",
  "description": "Status verifikasi per kandidat (F1.3). Field cek URL dan tanggal diisi tool deterministik, bukan dinilai LLM.",
  "type": "object",
  "required": ["verifiedAt", "windowDays", "results"],
  "additionalProperties": false,
  "properties": {
    "verifiedAt": { "type": "string", "format": "date-time" },
    "windowDays": { "type": "integer", "minimum": 1, "maximum": 30 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["candidateId", "url", "status", "checks"],
      "additionalProperties": false,
      "properties": {
        "candidateId": { "type": "string", "pattern": "^c[0-9]{2}$" },
        "url": { "type": "string", "format": "uri" },
        "status": {
          "type": "string",
          "enum": ["verified", "rejected"],
          "description": "verified hanya jika SEMUA cek deterministik lolos dan klaim utama ditemukan."
        },
        "reason": {
          "type": "string",
          "maxLength": 500,
          "description": "Wajib diisi bila status rejected."
        },
        "checks": {
          "type": "object",
          "required": ["urlReachable", "dateWithinWindow"],
          "additionalProperties": false,
          "description": "Hasil tool deterministik. LLM tidak boleh mengisi ini.",
          "properties": {
            "urlReachable": {
              "type": "object",
              "required": ["ok"],
              "additionalProperties": false,
              "properties": {
                "ok": { "type": "boolean" },
                "httpStatus": { "type": "integer" },
                "finalUrl": { "type": "string" },
                "error": { "type": "string" }
              }
            },
            "dateWithinWindow": {
              "type": "object",
              "required": ["ok"],
              "additionalProperties": false,
              "properties": {
                "ok": { "type": "boolean" },
                "publishedAt": { "type": "string" },
                "ageDays": { "type": "number" },
                "error": { "type": "string" }
              }
            },
            "claimFound": {
              "type": "object",
              "description": "Penilaian LLM: apakah klaim utama ringkasan ada di halaman.",
              "required": ["ok"],
              "additionalProperties": false,
              "properties": {
                "ok": { "type": "boolean" },
                "note": { "type": "string", "maxLength": 500 }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "rejected" } } },
          "then": {
            "required": ["reason"],
            "properties": { "reason": { "type": "string", "minLength": 1, "pattern": "\\S" } }
          }
        }
      ]
    }
  }
}
