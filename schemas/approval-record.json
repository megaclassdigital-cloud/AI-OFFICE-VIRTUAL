{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-office.local/schemas/approval-record.json",
  "title": "Record approval owner",
  "description": "Satu keputusan approve/reject oleh OWNER atas satu draf (F2.1). Disimpan sebagai berkas JSON append-only, satu berkas per record. Hash mengikat teks DAN semua PNG, sehingga draf yang berubah setelah approval tidak cocok lagi (F2.2). Hanya kode deterministik yang menulis record ini; LLM tidak pernah.",
  "type": "object",
  "required": ["schema_version", "record_id", "issue_id", "issue_identifier", "decision", "decided_at", "decided_by", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Versi skema record. Naikkan bila bentuk berubah; record lama tetap dibaca sesuai versinya."
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "issue_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID issue Paperclip."
    },
    "issue_identifier": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}-[0-9]+$",
      "description": "Pengenal terbaca manusia, mis. EDU-12."
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected"]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string",
      "const": "owner",
      "description": "Selalu `owner`. Identitas berasal dari token owner lokal, bukan dari isi pesan atau capability plugin."
    },
    "note": {
      "type": "string",
      "maxLength": 2000,
      "description": "Wajib dan tidak kosong bila decision = rejected (F2.3)."
    },
    "content_hash": {
      "type": "object",
      "required": ["algorithm", "combined", "text", "files"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "combined": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash gabungan teks + semua PNG, urut tetap."
        },
        "text": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash isi teks draf (carousel.json + carousel-design.json)."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "description": "Hash tiap PNG slide dan contact sheet.",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "rejected" } }, "required": ["decision"] },
      "then": {
        "required": ["note"],
        "properties": { "note": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      }
    }
  ]
}
