{
  "name": "ai-agent-office",
  "version": "0.1.0",
  "private": true,
  "description": "Repo AI Agent Office: plugin, template division, skema, script. Core Paperclip dipasang terpisah.",
  "license": "MIT",
  "scripts": {
    "console": "node console/server.mjs",
    "office": "node apps/office-view/server.mjs --open",
    "install-division": "node scripts/install-division.mjs",
    "render-spike": "node scripts/render-spike.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke-test.mjs",
    "loop-status": "node scripts/loop-status.js",
    "secret-scan": "node scripts/secret-scan.mjs",
    "office:talk": "node apps/office-view/server.mjs --port 3190 --paperclip http://127.0.0.1:3177 --enable-talk --open"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.56.0",
    "vitest": "5.0.3"
  }
}
